<?xml version="1.0" ?>
<!--
  電気室巡回点検ワールド
  - 盤3面(x=2, 5, 8)。2番盤の表示灯が1つ赤(異常)
  - カメラ付き差動二輪ロボット(カメラは左向き=盤の方向)
  - 速度指令: /cmd_vel  オドメトリ: /odom  カメラ画像: /camera
-->
<sdf version="1.8">
  <world name="inspection">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- 床 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 部屋の壁 -->
    <model name="room_walls">
      <static>true</static>
      <link name="link">
        <collision name="wall_north_c"><pose>4.5 3.1 1.25 0 0 0</pose><geometry><box><size>15 0.2 2.5</size></box></geometry></collision>
        <visual name="wall_north"><pose>4.5 3.1 1.25 0 0 0</pose><geometry><box><size>15 0.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
        <collision name="wall_south_c"><pose>4.5 -3.1 1.25 0 0 0</pose><geometry><box><size>15 0.2 2.5</size></box></geometry></collision>
        <visual name="wall_south"><pose>4.5 -3.1 1.25 0 0 0</pose><geometry><box><size>15 0.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
        <collision name="wall_west_c"><pose>-3.1 0 1.25 0 0 0</pose><geometry><box><size>0.2 6.4 2.5</size></box></geometry></collision>
        <visual name="wall_west"><pose>-3.1 0 1.25 0 0 0</pose><geometry><box><size>0.2 6.4 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
        <collision name="wall_east_c"><pose>12.1 0 1.25 0 0 0</pose><geometry><box><size>0.2 6.4 2.5</size></box></geometry></collision>
        <visual name="wall_east"><pose>12.1 0 1.25 0 0 0</pose><geometry><box><size>0.2 6.4 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 1番盤:正常(表示灯すべて緑) -->
    <model name="panel_1">
      <static>true</static>
      <pose>2 2.5 1.0 0 0 0</pose>
      <link name="body">
        <collision name="c"><geometry><box><size>1.0 0.6 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.6 2.0</size></box></geometry>
          <material><ambient>0.75 0.78 0.8 1</ambient><diffuse>0.75 0.78 0.8 1</diffuse></material></visual>
        <visual name="lamp_a"><pose>-0.25 -0.31 0.4 0 0 0</pose><geometry><box><size>0.14 0.02 0.14</size></box></geometry>
          <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse><emissive>0 0.6 0 1</emissive></material></visual>
        <visual name="lamp_b"><pose>0 -0.31 0.4 0 0 0</pose><geometry><box><size>0.14 0.02 0.14</size></box></geometry>
          <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse><emissive>0 0.6 0 1</emissive></material></visual>
        <visual name="lamp_c"><pose>0.25 -0.31 0.4 0 0 0</pose><geometry><box><size>0.14 0.02 0.14</size></box></geometry>
          <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse><emissive>0 0.6 0 1</emissive></material></visual>
      </link>
    </model>

    <!-- 2番盤:異常(中央の表示灯が赤) -->
    <model name="panel_2">
      <static>true</static>
      <pose>5 2.5 1.0 0 0 0</pose>
      <link name="body">
        <collision name="c"><geometry><box><size>1.0 0.6 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.6 2.0</size></box></geometry>
          <material><ambient>0.75 0.78 0.8 1</ambient><diffuse>0.75 0.78 0.8 1</diffuse></material></visual>
        <visual name="lamp_a"><pose>-0.25 -0.31 0.4 0 0 0</pose><geometry><box><size>0.14 0.02 0.14</size></box></geometry>
          <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse><emissive>0 0.6 0 1</emissive></material></visual>
        <visual name="lamp_b"><pose>0 -0.31 0.4 0 0 0</pose><geometry><box><size>0.14 0.02 0.14</size></box></geometry>
          <material><ambient>0.9 0 0 1</ambient><diffuse>0.9 0 0 1</diffuse><emissive>0.8 0 0 1</emissive></material></visual>
        <visual name="lamp_c"><pose>0.25 -0.31 0.4 0 0 0</pose><geometry><box><size>0.14 0.02 0.14</size></box></geometry>
          <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse><emissive>0 0.6 0 1</emissive></material></visual>
      </link>
    </model>

    <!-- 3番盤:正常 -->
    <model name="panel_3">
      <static>true</static>
      <pose>8 2.5 1.0 0 0 0</pose>
      <link name="body">
        <collision name="c"><geometry><box><size>1.0 0.6 2.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 0.6 2.0</size></box></geometry>
          <material><ambient>0.75 0.78 0.8 1</ambient><diffuse>0.75 0.78 0.8 1</diffuse></material></visual>
        <visual name="lamp_a"><pose>-0.25 -0.31 0.4 0 0 0</pose><geometry><box><size>0.14 0.02 0.14</size></box></geometry>
          <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse><emissive>0 0.6 0 1</emissive></material></visual>
        <visual name="lamp_b"><pose>0 -0.31 0.4 0 0 0</pose><geometry><box><size>0.14 0.02 0.14</size></box></geometry>
          <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse><emissive>0 0.6 0 1</emissive></material></visual>
        <visual name="lamp_c"><pose>0.25 -0.31 0.4 0 0 0</pose><geometry><box><size>0.14 0.02 0.14</size></box></geometry>
          <material><ambient>0 0.8 0 1</ambient><diffuse>0 0.8 0 1</diffuse><emissive>0 0.6 0 1</emissive></material></visual>
      </link>
    </model>

    <!-- 点検ロボット(diff_drive.sdf の車をベースにカメラを追加) -->
    <model name="inspector">
      <pose>0 0 0.325 0 0 0</pose>

      <link name="chassis">
        <pose>-0.151427 0 0.175 0 0 0</pose>
        <inertial>
          <mass>1.14395</mass>
          <inertia><ixx>0.126164</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.416519</iyy><iyz>0</iyz><izz>0.481014</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><box><size>2.01142 1 0.568726</size></box></geometry>
          <material><ambient>1.0 0.55 0.0 1</ambient><diffuse>1.0 0.55 0.0 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>2.01142 1 0.568726</size></box></geometry>
        </collision>
        <!-- カメラ台 -->
        <visual name="camera_mount">
          <pose>0 0.35 0.45 0 0 0</pose>
          <geometry><box><size>0.15 0.15 0.35</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <!-- カメラ:左(+y、盤の方向)を向く -->
        <sensor name="camera" type="camera">
          <pose>0 0.45 0.55 0 0 1.5708</pose>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>320</width><height>240</height></image>
            <clip><near>0.1</near><far>50</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>5</update_rate>
          <visualize>true</visualize>
          <topic>camera</topic>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>0.554283 0.625029 -0.025 -1.5707 0 0</pose>
        <inertial>
          <mass>2</mass>
          <inertia><ixx>0.145833</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.145833</iyy><iyz>0</iyz><izz>0.125</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.25</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.25</length></cylinder></geometry>
        </collision>
      </link>

      <link name="right_wheel">
        <pose>0.554282 -0.625029 -0.025 -1.5707 0 0</pose>
        <inertial>
          <mass>2</mass>
          <inertia><ixx>0.145833</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.145833</iyy><iyz>0</iyz><izz>0.125</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.25</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.25</length></cylinder></geometry>
        </collision>
      </link>

      <link name="caster">
        <pose>-0.957138 0 -0.125 0 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.1</iyy><iyz>0</iyz><izz>0.1</izz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.2</radius></sphere></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>0.2</radius></sphere></geometry>
        </collision>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis>
      </joint>
      <joint name="caster_wheel" type="ball">
        <parent>chassis</parent>
        <child>caster</child>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>1.25</wheel_separation>
        <wheel_radius>0.3</wheel_radius>
        <odom_publish_frequency>10</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
      </plugin>
    </model>
  </world>
</sdf>
